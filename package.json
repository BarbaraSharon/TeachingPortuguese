{
  "name": "hugo-blox-landing-page-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Landing page starter template for Hugo Blox with Tailwind CSS v4",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify && npm run language:routing:check && npm run titles:check && npm run descriptions:check && npm run pagefind && npm run redirects && npm run redirects:check && npm run metadata:check",
    "language:routing:check": "node scripts/check-language-routing.mjs",
    "metadata:check": "node scripts/check-generated-metadata.mjs",
    "titles:check": "node scripts/check-seo-titles.mjs",
    "descriptions:check": "node scripts/check-seo-descriptions.mjs",
    "pagefind": "pagefind --site public",
    "redirects": "node scripts/generate-legacy-redirects.mjs",
    "redirects:check": "node scripts/generate-legacy-redirects.mjs --check"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
